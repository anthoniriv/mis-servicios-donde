generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Service { water electricity internet }
enum Provider { sedapal luz_del_sur pluz movistar claro win wow mifibra other }
enum ReportStatus { outage restored }
enum TrustDecision { eligible excluded }
enum EpisodeClosureReason { restored expired }
enum AlertIntentStatus { pending delivered retryable cancelled }

model PilotZone {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  approved  Boolean  @default(false)
  boundary  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  episodes  OutageEpisode[]
}

model SubmissionRecord {
  id              String   @id @default(uuid()) @db.Uuid
  deviceToken     String
  submissionId    String
  requestHash     String
  trustDecision   TrustDecision
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  events          ReportEvent[]
  @@unique([deviceToken, submissionId])
  @@index([deviceToken, createdAt])
  @@index([expiresAt])
}

model ReportEvent {
  id           String       @id @default(uuid()) @db.Uuid
  submissionId String       @db.Uuid
  h3Cell       String
  service      Service
  provider     Provider
  status       ReportStatus
  deviceToken  String
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  submission   SubmissionRecord @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  displayName  ReportDisplayName?
  @@index([h3Cell, service, provider, status, createdAt])
  @@index([expiresAt])
}

model ReportDisplayName {
  reportEventId String   @id @db.Uuid
  value         String
  expiresAt     DateTime
  reportEvent   ReportEvent @relation(fields: [reportEventId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model AbuseRecord {
  id          String   @id @default(uuid()) @db.Uuid
  deviceToken String
  decision    TrustDecision
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  @@index([deviceToken, createdAt])
  @@index([expiresAt])
}

model OutageEpisode {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  h3Cell    String
  service   Service
  provider  Provider
  active    Boolean  @default(true)
  expiresAt DateTime
  openedAt  DateTime @default(now())
  lastQuorumAt DateTime @default(now())
  closedAt  DateTime?
  closureReason EpisodeClosureReason?
  zone      PilotZone @relation(fields: [zoneId], references: [id])
  alerts    AlertIntent[]
  @@index([h3Cell, service, provider, active, expiresAt])
}

model AlertIntent {
  id              String            @id @default(uuid()) @db.Uuid
  episodeId       String            @db.Uuid
  kind            String
  content         String
  status          AlertIntentStatus @default(pending)
  attempts        Int               @default(0)
  nextAttemptAt   DateTime          @default(now())
  leaseToken      String?           @db.Uuid
  leaseExpiresAt  DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  episode         OutageEpisode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  @@unique([episodeId, kind])
  @@index([status, nextAttemptAt])
}
