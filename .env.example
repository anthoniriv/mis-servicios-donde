# Development database. The integration suite uses mis_servicios_test and never this one.
DATABASE_URL=postgresql://mis_servicios:mis_servicios@127.0.0.1:54329/mis_servicios
PORT=3000

# Product gates remain disabled until pilot zones and H3 resolution are approved.
INTAKE_ENABLED=false
PUBLIC_MAP_ENABLED=false
ALERT_DISPATCH_ENABLED=false
RETENTION_WORKER_ENABLED=false

# Intake refuses every report while H3_RESOLUTION or DEVICE_TOKEN_SECRET is absent.
H3_RESOLUTION=9

TELEGRAM_BOT_TOKEN=zzzz
TELEGRAM_CHAT_ID=zzz

INTAKE_ENABLED=true
PUBLIC_MAP_ENABLED=true
DEVICE_TOKEN_SECRET=local-development-only-not-a-real-secret

# HTTP hardening defaults; tune at the edge and keep the API single-instance until
# the limiter is moved to Redis/Upstash for horizontally scaled deployments.
WEB_ORIGIN=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_KEYS=10000

# Keep the API's database footprint bounded when deployed with a pooled Neon URL.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
